# Get an API key from https://serpapi.com/ (Google Shopping engine)
SERPAPI_KEY=put_your_api_key_here
PORT=3000
# Minimum time between refreshes for the same search, in seconds
CACHE_TTL_SECONDS=300

# Affiliate tags (leave empty if none)
AMAZON_AFFILIATE_TAG=
FLIPKART_AFFILIATE_TAG=
TATACLIQ_AFFILIATE_TAG=
MYNTRA_AFFILIATE_TAG=

# ── Email (Welcome mail + OTP for forgot password) ──────────────────────────
# All emails are sent FROM this Gmail account (haggledeals26@gmail.com).
EMAIL_USER=haggledeals26@gmail.com
# Gmail App Password (NOT your login password):
# 1. Google Account → Security → 2-Step Verification ON
# 2. Search "App passwords" → create one for "Mail" → paste the 16-char code here
EMAIL_PASS=
# Optional: Google Apps Script webhook URL (primary channel, bypasses cloud firewalls)
GMAIL_WEBHOOK_URL=

# HOW TO KEEP MAIL OUT OF SPAM (haggledeals26@gmail.com):
# - Gmail automatically signs with SPF/DKIM when sending via smtp.gmail.com
#   or Apps Script as your own Gmail address — no extra DNS records needed.
# - Emails already include a plain-text alternative part + Reply-To +
#   X-Entity-Ref-ID headers (best-practice anti-spam signals).
# - Ask new users to "Add haggledeals26@gmail.com to contacts" (footer does this).
# - Keep the welcome mail and OTP mails going to engaged users; avoid mass blasts.

# ── Sessions & Site ──────────────────────────────────────────────────────────
# Set a strong secret (32+ random chars) in production
JWT_SECRET=
# Public base URL used in email links
SITE_URL=https://haggle-2mki.onrender.com
